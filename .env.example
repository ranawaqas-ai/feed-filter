# Only needed for the optional local proxy and for the end-to-end tests.
# Copy to .env (git-ignored) and fill in. Never commit .env.

# Your TypeSafe key, from https://console.typesafe.ai/keys
jev_api_key=

# Any long random string; paste the same value into the extension's settings (Local proxy).
# For example: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
proxy_shared_secret=

# chrome-extension://<your extension id>, shown on chrome://extensions after loading the extension.
proxy_extension_origin=

# Optional
# proxy_port=8787
# proxy_daily_call_cap=3000
